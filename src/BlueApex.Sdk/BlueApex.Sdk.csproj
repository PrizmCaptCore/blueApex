<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Authors>prizmcaptcore</Authors>
    <Copyright>Copyright (c) 2026 prizmcaptcore</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <Description>Widget SDK for BlueApex: implement IWidgetProvider in a DLL, drop it in %AppData%\BlueApex\widgets\&lt;name&gt;\, and it appears under "위젯 추가".</Description>
  </PropertyGroup>

</Project>
