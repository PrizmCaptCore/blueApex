<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Bump this for a release; the installer and the update check read it (see docs/release.md). -->
    <Version>0.2.0</Version>
    <Authors>prizmcaptcore</Authors>
    <!-- Only the languages the UI actually has; keeps the self-contained publish smaller. -->
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <Copyright>Copyright (c) 2026 prizmcaptcore</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by build\make-icon.ps1 (a blue mountain peak); also used by the installer. -->
    <ApplicationIcon>Assets\blueapex.ico</ApplicationIcon>
    <!-- WFO0003 wants DPI set the WinForms way; this is a WPF app, so the manifest is correct. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueApex.Sdk\BlueApex.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon travels inside the exe as a WPF resource (pack URI). -->
    <Resource Include="Assets\tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
