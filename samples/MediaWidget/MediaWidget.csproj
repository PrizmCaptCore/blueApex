<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample BlueApex widget plugin: "now playing" from Windows' system media
       transport controls. Targets a Windows 10 SDK version so the WinRT
       Windows.Media.Control API is available. The host app does not carry the
       WinRT projection, so the two support DLLs are copied next to the plugin
       (the host resolves a plugin's dependencies from its own folder). -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlueApex.Sdk\BlueApex.Sdk.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CopyWinRtSupport" AfterTargets="Build">
    <ItemGroup>
      <WinRtSupport Include="$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\*\lib\net8.0\Microsoft.Windows.SDK.NET.dll;$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\*\lib\net8.0\WinRT.Runtime.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WinRtSupport)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
